#!/bin/sh
# Production network startup for Equip-1.
# Default mode is a self-contained Wi-Fi access point for phone/laptop control.
# Set EQUIP1_WIFI_MODE=client to use /etc/wpa_supplicant.conf instead.

LOG_DIR=/var/log/equip1
LOGFILE=$LOG_DIR/network.log
HOSTAPD_PID=/var/run/hostapd-equip1.pid
DNSMASQ_PID=/var/run/dnsmasq-equip1.pid
HOSTAPD_CONF=/var/run/hostapd-equip1.conf
HOSTAPD_LOG=$LOG_DIR/hostapd.log
DNSMASQ_LOG=$LOG_DIR/dnsmasq.log

if [ -r /etc/equip1/settings-env.sh ]; then
    . /etc/equip1/settings-env.sh
    equip1_ini_default EQUIP1_WIFI_MODE network wifi_mode ap
    equip1_ini_default EQUIP1_AP_IFACE network ap_iface wlan0
    equip1_ini_default EQUIP1_AP_SSID network ap_ssid Equip-1
    equip1_ini_default EQUIP1_AP_PASSWORD network ap_password firesecret
    equip1_ini_default EQUIP1_AP_IP network ap_ip 10.42.0.1
    equip1_ini_default EQUIP1_AP_CIDR network ap_cidr 24
    equip1_ini_default EQUIP1_AP_CHANNEL network ap_channel 6
    equip1_ini_default EQUIP1_AP_DHCP_START network ap_dhcp_start 10.42.0.10
    equip1_ini_default EQUIP1_AP_DHCP_END network ap_dhcp_end 10.42.0.100
    equip1_ini_default EQUIP1_AP_DHCP_LEASE network ap_dhcp_lease 12h
    equip1_ini_default EQUIP1_AP_COUNTRY network ap_country ""
    equip1_ini_default EQUIP1_NETWORK_BACKGROUND network startup_background 1
    equip1_ini_default EQUIP1_CLIENT_FALLBACK_AP network client_fallback_ap 1
    equip1_ini_default EQUIP1_SETTINGS_FILE paths settings_file /etc/equip1/equip-1.ini
    equip1_ini_default EQUIP1_LOG_LEVEL logging log_level info
    equip1_ini_default EQUIP_1_BOARD_TYPE ui board_type rock2f
fi

WIFI_MODE="${EQUIP1_WIFI_MODE:-ap}"
AP_IFACE="${EQUIP1_AP_IFACE:-wlan0}"
AP_SSID="${EQUIP1_AP_SSID:-Equip-1}"
AP_PASSWORD="${EQUIP1_AP_PASSWORD:-firesecret}"
AP_IP="${EQUIP1_AP_IP:-10.42.0.1}"
AP_CIDR="${EQUIP1_AP_CIDR:-24}"
AP_CHANNEL="${EQUIP1_AP_CHANNEL:-6}"
AP_DHCP_START="${EQUIP1_AP_DHCP_START:-10.42.0.10}"
AP_DHCP_END="${EQUIP1_AP_DHCP_END:-10.42.0.100}"
AP_DHCP_LEASE="${EQUIP1_AP_DHCP_LEASE:-12h}"
AP_COUNTRY="${EQUIP1_AP_COUNTRY:-}"
NETWORK_BACKGROUND="${EQUIP1_NETWORK_BACKGROUND:-1}"
CLIENT_FALLBACK_AP="${EQUIP1_CLIENT_FALLBACK_AP:-1}"
SETTINGS_FILE="${EQUIP1_SETTINGS_FILE:-/etc/equip1/equip-1.ini}"
BOARD_TYPE="$(printf '%s' "${EQUIP_1_BOARD_TYPE:-rock2f}" | tr 'A-Z' 'a-z')"
LOG_LEVEL="$(printf '%s' "${EQUIP1_LOG_LEVEL:-info}" | tr 'A-Z' 'a-z')"
if [ "$LOG_LEVEL" = "quiet" ]; then
    LOGFILE=/dev/null
    HOSTAPD_LOG=/dev/null
    DNSMASQ_LOG=/dev/null
fi

log() {
    [ "$LOG_LEVEL" = "quiet" ] && return 0
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    echo "$(date 2>/dev/null || true) $*" >>"$LOGFILE" 2>/dev/null || true
    echo "$*"
}

redact_value() {
    sed -E 's/(passphrase=|wpa_passphrase=|psk=).*/\1<redacted>/'
}

load_wifi_modules() {
    case "$BOARD_TYPE" in
        rpi|pi5|raspberrypi|raspberry-pi*)
            modprobe brcmfmac >>"$LOGFILE" 2>&1 || true
            return 0
            ;;
    esac

    load_fw_module="$(find /lib/modules -type f -name aic_load_fw.ko | head -1)"
    wlan_module="$(find /lib/modules -type f -name aic8800_fdrv.ko | head -1)"

    modprobe aic_load_fw aic_fw_path=/lib/firmware/aic8800_fw/USB >>"$LOGFILE" 2>&1 || true
    if [ -n "$load_fw_module" ] && [ ! -d /sys/module/aic_load_fw ]; then
        insmod "$load_fw_module" aic_fw_path=/lib/firmware/aic8800_fw/USB >>"$LOGFILE" 2>&1 || true
    fi

    sleep 1

    modprobe aic8800_fdrv >>"$LOGFILE" 2>&1 || true
    if [ -n "$wlan_module" ] && [ ! -d /sys/module/aic8800_fdrv ]; then
        insmod "$wlan_module" >>"$LOGFILE" 2>&1 || true
    fi
}

wait_for_iface() {
    iface="$1"
    for _ in $(seq 1 30); do
        if ip link show "$iface" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

stop_network_services() {
    if [ -f "$HOSTAPD_PID" ]; then
        kill "$(cat "$HOSTAPD_PID")" 2>/dev/null || true
        rm -f "$HOSTAPD_PID"
    fi
    if [ -f "$DNSMASQ_PID" ]; then
        kill "$(cat "$DNSMASQ_PID")" 2>/dev/null || true
        rm -f "$DNSMASQ_PID"
    fi
    killall hostapd 2>/dev/null || true
    killall dnsmasq 2>/dev/null || true
    killall wpa_supplicant 2>/dev/null || true
    killall udhcpc 2>/dev/null || true
}

write_hostapd_conf() {
    mkdir -p /var/run /var/log 2>/dev/null || true
    {
        echo "interface=$AP_IFACE"
        echo "driver=nl80211"
        echo "ssid=$AP_SSID"
        echo "hw_mode=g"
        echo "channel=$AP_CHANNEL"
        echo "ieee80211n=1"
        echo "wmm_enabled=1"
        echo "auth_algs=1"
        echo "ignore_broadcast_ssid=0"
        echo "wpa=2"
        echo "wpa_key_mgmt=WPA-PSK"
        echo "wpa_pairwise=CCMP"
        echo "rsn_pairwise=CCMP"
        echo "wpa_passphrase=$AP_PASSWORD"
        if [ -n "$AP_COUNTRY" ]; then
            echo "country_code=$AP_COUNTRY"
            echo "ieee80211d=1"
        fi
    } >"$HOSTAPD_CONF"
    chmod 600 "$HOSTAPD_CONF" 2>/dev/null || true
}

start_ap() {
    log "Starting WiFi AP: ssid=$AP_SSID iface=$AP_IFACE ip=$AP_IP/$AP_CIDR channel=$AP_CHANNEL"

    if [ ${#AP_PASSWORD} -lt 8 ] || [ ${#AP_PASSWORD} -gt 63 ]; then
        log "AP password must be 8..63 characters for WPA2-PSK"
        return 1
    fi
    if ! command -v hostapd >/dev/null 2>&1; then
        log "hostapd missing; cannot start AP"
        return 1
    fi
    if ! command -v dnsmasq >/dev/null 2>&1; then
        log "dnsmasq missing; cannot start AP DHCP"
        return 1
    fi

    load_wifi_modules
    if ! wait_for_iface "$AP_IFACE"; then
        log "$AP_IFACE not present; cannot start AP"
        return 1
    fi

    stop_network_services
    ip link set "$AP_IFACE" down >>"$LOGFILE" 2>&1 || true
    ip addr flush dev "$AP_IFACE" >>"$LOGFILE" 2>&1 || true
    ip addr add "$AP_IP/$AP_CIDR" dev "$AP_IFACE" >>"$LOGFILE" 2>&1 || true
    ip link set "$AP_IFACE" up >>"$LOGFILE" 2>&1 || true
    iw dev "$AP_IFACE" set power_save off >>"$LOGFILE" 2>&1 || true

    write_hostapd_conf
    log "hostapd config:"
    redact_value <"$HOSTAPD_CONF" >>"$LOGFILE" 2>&1 || true

    : >"$HOSTAPD_LOG" 2>/dev/null || true
    : >"$DNSMASQ_LOG" 2>/dev/null || true
    if ! hostapd -B -P "$HOSTAPD_PID" -f "$HOSTAPD_LOG" "$HOSTAPD_CONF" >>"$LOGFILE" 2>&1; then
        log "hostapd failed; see $HOSTAPD_LOG"
        cat "$HOSTAPD_LOG" >>"$LOGFILE" 2>&1 || true
        return 1
    fi

    dnsmasq \
        --no-resolv \
        --interface="$AP_IFACE" \
        --bind-interfaces \
        --listen-address="$AP_IP" \
        --dhcp-range="$AP_DHCP_START,$AP_DHCP_END,$AP_DHCP_LEASE" \
        --dhcp-option="3,$AP_IP" \
        --dhcp-option="6,$AP_IP" \
        --address="/equip-1/$AP_IP" \
        --address="/equip-1.local/$AP_IP" \
        --address="/equip1.local/$AP_IP" \
        --pid-file="$DNSMASQ_PID" \
        --log-facility="$DNSMASQ_LOG" >>"$LOGFILE" 2>&1 || {
            log "dnsmasq failed; see $DNSMASQ_LOG"
            cat "$DNSMASQ_LOG" >>"$LOGFILE" 2>&1 || true
            return 1
        }

    ip addr show "$AP_IFACE" >>"$LOGFILE" 2>&1 || true
    log "WiFi AP ready: http://$AP_IP/"
}

set_wifi_mode_ap() {
    [ -n "$SETTINGS_FILE" ] || return 0
    mkdir -p "$(dirname "$SETTINGS_FILE")" 2>/dev/null || true
    if [ ! -f "$SETTINGS_FILE" ]; then
        {
            echo "[network]"
            echo "wifi_mode = ap"
        } >"$SETTINGS_FILE" 2>/dev/null || true
        return 0
    fi
    awk '
        BEGIN { in_network=0; saw_network=0; set_mode=0 }
        /^\[network\][[:space:]]*$/ { in_network=1; saw_network=1; print; next }
        /^\[/ {
            if (in_network && !set_mode) { print "wifi_mode = ap"; set_mode=1 }
            in_network=0
        }
        in_network && /^[[:space:]]*wifi_mode[[:space:]]*=/ { print "wifi_mode = ap"; set_mode=1; next }
        { print }
        END {
            if (!saw_network) { print ""; print "[network]"; print "wifi_mode = ap" }
            else if (in_network && !set_mode) { print "wifi_mode = ap" }
        }
    ' "$SETTINGS_FILE" >"$SETTINGS_FILE.tmp" 2>/dev/null && mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE" 2>/dev/null || rm -f "$SETTINGS_FILE.tmp" 2>/dev/null || true
}

wait_for_client_ip() {
    for _ in $(seq 1 30); do
        CLIENT_IP="$(ip -4 -o addr show dev "$AP_IFACE" 2>/dev/null | awk '$3 == "inet" { sub(/\/.*/, "", $4); print $4; exit }')"
        if [ -n "$CLIENT_IP" ]; then
            log "WiFi client ready: http://$CLIENT_IP/"
            return 0
        fi
        sleep 1
    done
    return 1
}

wpa_status() {
    if command -v wpa_cli >/dev/null 2>&1; then
        wpa_cli -i "$AP_IFACE" status >>"$LOGFILE" 2>&1 || true
    fi
}

wait_for_wifi_ready() {
    for _ in $(seq 1 60); do
        if [ "$(cat /sys/class/net/$AP_IFACE/carrier 2>/dev/null)" = "1" ]; then
            log "$AP_IFACE carrier is up"
            return 0
        fi
        if command -v wpa_cli >/dev/null 2>&1; then
            STATE="$(wpa_cli -i "$AP_IFACE" status 2>/dev/null | sed -n 's/^wpa_state=//p' | tail -1)"
            [ -n "$STATE" ] && log "wpa_state=$STATE"
            if [ "$STATE" = "COMPLETED" ]; then
                return 0
            fi
        fi
        sleep 1
    done
    log "$AP_IFACE did not associate within 60s; starting DHCP anyway for continued background retries"
    wpa_status
    return 1
}

start_client() {
    log "Starting WiFi client on $AP_IFACE"
    load_wifi_modules
    if ! wait_for_iface "$AP_IFACE"; then
        log "$AP_IFACE not present; skipping WiFi client startup"
        return 0
    fi

    stop_network_services
    ip link set "$AP_IFACE" down >>"$LOGFILE" 2>&1 || true
    ip addr flush dev "$AP_IFACE" >>"$LOGFILE" 2>&1 || true
    ip link set "$AP_IFACE" up >>"$LOGFILE" 2>&1 || true
    iw dev "$AP_IFACE" set power_save off >>"$LOGFILE" 2>&1 || true
    ip addr show "$AP_IFACE" >>"$LOGFILE" 2>&1 || true
    sed -E 's/^(\s*psk=).*/\1<redacted>/' /etc/wpa_supplicant.conf >>"$LOGFILE" 2>&1 || true

    if ! wpa_supplicant -B -i "$AP_IFACE" -c /etc/wpa_supplicant.conf >>"$LOGFILE" 2>&1; then
        log "wpa_supplicant failed to start"
        return 1
    fi
    wait_for_wifi_ready || true
    wpa_status
    udhcpc -i "$AP_IFACE" -b >>"$LOGFILE" 2>&1 || true
    if ! wait_for_client_ip; then
        log "WiFi client did not get an IP address"
        if [ "$CLIENT_FALLBACK_AP" = "1" ] || [ "$CLIENT_FALLBACK_AP" = "true" ]; then
            log "Falling back to Equip-1 AP mode"
            set_wifi_mode_ap
            start_ap
        fi
    fi
}

case "$1" in
    start)
        mkdir -p "$LOG_DIR" 2>/dev/null || true
        echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) S50network start" >> "$LOG_DIR/boot-crumb.log" 2>/dev/null || true
        mkdir -p /var/run /var/log 2>/dev/null || true
        : >"$LOGFILE" 2>/dev/null || true
        log "Starting network startup sequence mode=$WIFI_MODE"
        case "$WIFI_MODE" in
            ap|access_point|hotspot)
                if [ "$NETWORK_BACKGROUND" = "1" ] || [ "$NETWORK_BACKGROUND" = "true" ]; then
                    log "Continuing boot while AP starts in background"
                    start_ap >>"$LOGFILE" 2>&1 &
                else
                    start_ap
                fi
                ;;
            client|station|sta)
                if [ "$NETWORK_BACKGROUND" = "1" ] || [ "$NETWORK_BACKGROUND" = "true" ]; then
                    log "Continuing boot while WiFi client starts in background"
                    start_client >>"$LOGFILE" 2>&1 &
                else
                    start_client
                fi
                ;;
            off|disabled|none)
                log "WiFi disabled by EQUIP1_WIFI_MODE=$WIFI_MODE"
                ;;
            *)
                log "Unknown EQUIP1_WIFI_MODE=$WIFI_MODE; expected ap/client/off"
                exit 1
                ;;
        esac
        ;;
    stop)
        stop_network_services
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
