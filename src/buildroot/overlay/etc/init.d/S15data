#!/bin/sh
# Mount the recordings data partition at /data.
#
# Preferred layout:
#   - SD card: boot/rootfs
#   - USB-A drive/SSD: exFAT partition for captures
#
# Prefer a non-root-disk exFAT partition labelled EQUIP1. If none exists, use a
# single unambiguous non-root exFAT partition. Otherwise fall back to the next
# partition after rootfs, creating and formatting that SD-card recordings partition
# on first boot when a compressed-image flash left the rest of the card free.

if [ -r /etc/equip1/settings-env.sh ]; then
    . /etc/equip1/settings-env.sh
    equip1_ini_default EQUIP1_DATA_MNT recording data_mount /data
    equip1_ini_default EQUIP1_DATA_LABEL recording storage_label EQUIP1
    equip1_ini_default EQUIP1_DATA_MOUNT_OPTS recording data_mount_options noatime
    equip1_ini_default EQUIP1_DATA_MOUNT_TIMEOUT recording data_mount_timeout 15
    equip1_ini_default EQUIP1_USB_DATA_WAIT_SECS recording usb_data_wait_seconds 0
    equip1_ini_default EQUIP1_DATA_BOOT_DIAGNOSTICS recording data_boot_diagnostics 0
fi

DATA_MNT="${EQUIP1_DATA_MNT:-/data}"
DATA_LABEL="${EQUIP1_DATA_LABEL:-EQUIP1}"
MOUNT_OPTS="${EQUIP1_DATA_MOUNT_OPTS:-noatime}"
MOUNT_TIMEOUT="${EQUIP1_DATA_MOUNT_TIMEOUT:-15}"
USB_WAIT_SECS="${EQUIP1_USB_DATA_WAIT_SECS:-0}"
BOOT_DIAGNOSTICS="${EQUIP1_DATA_BOOT_DIAGNOSTICS:-0}"
LOG_DIR="/var/log/equip1"
BOOT_LOG="$LOG_DIR/boot-crumb.log"

log() {
    mkdir -p "$LOG_DIR" 2>/dev/null || true
    echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) S15data: $*" >>"$BOOT_LOG" 2>/dev/null || true
}

mounted_at_data() {
    awk -v m="$DATA_MNT" '$2 == m { found=1 } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

dump_usb_state() {
    reason="$1"
    log "USB diagnostics begin: $reason"
    {
        echo "--- /proc/partitions ---"
        cat /proc/partitions 2>/dev/null || true
        echo "--- blkid ---"
        blkid 2>&1 || true
        echo "--- /sys/block/sd* ---"
        for disk_path in /sys/block/sd*; do
            [ -e "$disk_path" ] || continue
            disk="$(basename "$disk_path")"
            echo "$disk: removable=$(cat "$disk_path/removable" 2>/dev/null || echo '?') size=$(cat "$disk_path/size" 2>/dev/null || echo '?')"
            for part_path in "$disk_path"/"$disk"[0-9]*; do
                [ -e "$part_path" ] || continue
                part="$(basename "$part_path")"
                echo "  $part size=$(cat "$part_path/size" 2>/dev/null || echo '?') dev=$(cat "$part_path/dev" 2>/dev/null || echo '?')"
            done
        done
        echo "--- /dev/sd* ---"
        ls -l /dev/sd* 2>&1 || true
        echo "--- dmesg usb tail ---"
        dmesg 2>/dev/null | grep -iE 'usb|uas|scsi|sd[a-z]|exfat' | tail -60 || true
    } | while IFS= read -r line; do
        log "diag: $line"
    done
    log "USB diagnostics end: $reason"
}

partition_disk() {
    part="$1"
    case "$part" in
        *mmcblk*p[0-9]*|*nvme*n[0-9]*p[0-9]*) echo "${part%p[0-9]*}" ;;
        /dev/*[0-9])                              echo "${part%[0-9]*}" ;;
        *)                                        echo "$part" ;;
    esac
}

root_part_from_rootfs() {
    blkid 2>/dev/null | grep 'LABEL="rootfs"' | head -1 | cut -d: -f1
}

root_disk_from_rootfs() {
    rootdev="$(root_part_from_rootfs)"
    [ -n "$rootdev" ] || return 1
    partition_disk "$rootdev"
}

partition_number() {
    part="$1"
    case "$part" in
        *mmcblk*p[0-9]*|*nvme*n[0-9]*p[0-9]*) echo "${part##*p}" ;;
        /dev/*[0-9])                              echo "${part##*[!0-9]}" ;;
        *)                                        return 1 ;;
    esac
}

sd_data_part_from_rootfs_disk() {
    rootdev="$(root_part_from_rootfs)"
    [ -n "$rootdev" ] || return 1
    disk="$(partition_disk "$rootdev")"
    num="$(partition_number "$rootdev")"
    case "$num" in ''|*[!0-9]*) return 1 ;; esac
    data_num=$((num + 1))
    case "$disk" in
        *mmcblk*|*nvme*) echo "${disk}p${data_num}" ;;
        /dev/?*)         echo "${disk}${data_num}" ;;
        *)               return 1 ;;
    esac
}

reread_partitions() {
    disk="$1"
    partprobe "$disk" >/dev/null 2>&1 || true
    blockdev --rereadpt "$disk" >/dev/null 2>&1 || true
    mdev -s >/dev/null 2>&1 || true
    sleep 1
}

last_free_region_sectors() {
    disk="$1"
    # parted -m prints free-space lines like:
    #   1:2115003s:62333918s:60218916s:free;
    # where field 2 is the start sector and field 4 is the size. Use the last
    # free region so existing boot/rootfs partitions remain intact.
    parted -m -s "$disk" unit s print free 2>/dev/null \
        | awk -F: '/:free;$/ { start=$2; size=$4 } END { if (start != "" && size != "") { sub(/s$/, "", start); sub(/s$/, "", size); print start " " size } }'
}

partition_table_type() {
    disk="$1"
    parted -m -s "$disk" print 2>/dev/null | awk -F: 'NR == 2 { print $6; exit }'
}

disk_has_gpt_header() {
    disk="$1"
    sig="$(dd if="$disk" bs=512 skip=1 count=1 2>/dev/null | dd bs=8 count=1 2>/dev/null || true)"
    [ "$sig" = "EFI PART" ]
}

repair_gpt_backup_header() {
    disk="$1"

    # Compressed-image flashers write the small image GPT verbatim to larger SD
    # cards. The backup GPT then remains at the old image end, so parted may not
    # see the unallocated card space. Move the backup GPT to the real device end
    # before looking for a free region, matching scripts/flash.sh's host path.
    disk_has_gpt_header "$disk" || return 0

    if ! command -v sgdisk >/dev/null 2>&1; then
        log "cannot repair GPT on $disk: sgdisk is not installed"
        return 1
    fi

    log "ensuring GPT backup header on $disk is at end of device"
    if sgdisk -e "$disk" >/run/S15data.sgdisk.out 2>&1; then
        reread_partitions "$disk"
        return 0
    fi

    while IFS= read -r line; do
        log "sgdisk -e error for $disk: $line"
    done </run/S15data.sgdisk.out
    return 1
}

provision_sd_data_part() {
    disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    [ -n "$disk" ] || { log "cannot provision SD data partition: rootfs disk not found"; return 1; }

    part="$(sd_data_part_from_rootfs_disk 2>/dev/null || true)"
    [ -n "$part" ] || { log "cannot provision SD data partition: unsupported rootfs disk $disk"; return 1; }

    if [ -b "$part" ]; then
        log "SD data partition $part already exists; provisioning not needed"
        return 0
    fi

    if ! command -v parted >/dev/null 2>&1; then
        log "cannot provision SD data partition: parted is not installed"
        return 1
    fi
    if ! command -v mkfs.exfat >/dev/null 2>&1; then
        log "cannot provision SD data partition: mkfs.exfat is not installed"
        return 1
    fi
    if ! repair_gpt_backup_header "$disk"; then
        log "cannot provision SD data partition on $disk: GPT backup-header repair failed"
        return 1
    fi

    table="$(partition_table_type "$disk")"
    if [ -n "$table" ] && [ "$table" != "gpt" ] && [ "$table" != "msdos" ]; then
        log "cannot provision SD data partition on $disk: unsupported partition table $table"
        return 1
    fi

    set -- $(last_free_region_sectors "$disk")
    start="${1:-}"
    size="${2:-}"
    case "$start$size" in
        ''|*[!0-9]*) log "cannot provision SD data partition on $disk: no usable free region found"; return 1 ;;
    esac
    if [ "$start" -lt 2048 ]; then
        log "cannot provision SD data partition on $disk: suspicious free-region start ${start}s"
        return 1
    fi
    min_sectors="${EQUIP1_DATA_MIN_FREE_SECTORS:-262144}"
    case "$min_sectors" in ''|*[!0-9]*) min_sectors=262144 ;; esac
    if [ "$size" -lt "$min_sectors" ]; then
        log "cannot provision SD data partition on $disk: free region is only ${size}s"
        return 1
    fi

    data_num="$(partition_number "$part")"
    case "$data_num" in ''|*[!0-9]*) log "cannot provision SD data partition: could not infer partition number from $part"; return 1 ;; esac

    log "creating SD recordings partition on $disk from sector ${start}s to end"
    if ! parted -s "$disk" mkpart recordings "${start}s" 100%; then
        log "could not create SD recordings partition on $disk"
        return 1
    fi
    if [ "$table" = "gpt" ]; then
        parted -s "$disk" name "$data_num" recordings >/dev/null 2>&1 || true
        parted -s "$disk" set "$data_num" msftdata on >/dev/null 2>&1 || true
    fi

    reread_partitions "$disk"
    tries=0
    while [ ! -b "$part" ] && [ "$tries" -lt 10 ]; do
        reread_partitions "$disk"
        tries=$((tries + 1))
    done
    [ -b "$part" ] || { log "created partition but $part did not appear"; return 1; }

    log "formatting SD recordings partition $part as exFAT label $DATA_LABEL"
    if ! mkfs.exfat -n "$DATA_LABEL" "$part" >/run/S15data.mkfs.out 2>&1; then
        while IFS= read -r line; do
            log "mkfs.exfat error for $part: $line"
        done </run/S15data.mkfs.out
        return 1
    fi
    return 0
}

blkid_field() {
    field="$1"
    part="$2"
    value="$(blkid -o value -s "$field" "$part" 2>/dev/null || true)"
    case "$value" in
        *"$field="*|*LABEL=*|*UUID=*|*TYPE=*|/dev/*:*) ;;
        *) [ -n "$value" ] && { echo "$value"; return 0; } ;;
    esac
    blkid "$part" 2>/dev/null | sed -n "s/.*$field=\"\([^\"]*\)\".*/\1/p" | head -1
}

blkid_parts() {
    blkid 2>/dev/null | cut -d: -f1
}

usb_block_parts() {
    root_disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    for disk_path in /sys/block/sd*; do
        [ -e "$disk_path" ] || continue
        disk="/dev/$(basename "$disk_path")"
        if [ -n "$root_disk" ] && [ "$disk" = "$root_disk" ]; then
            continue
        fi

        found_part=0
        for part_path in "$disk_path"/$(basename "$disk_path")[0-9]*; do
            [ -e "$part_path" ] || continue
            part="/dev/$(basename "$part_path")"
            [ -b "$part" ] || continue
            echo "$part"
            found_part=1
        done
        if [ "$found_part" -eq 0 ] && [ -b "$disk" ]; then
            echo "$disk"
        fi
    done
}

single_usb_block_part() {
    found=""
    count=0
    for part in $(usb_block_parts); do
        count=$((count + 1))
        [ -n "$found" ] || found="$part"
    done
    if [ "$count" -eq 1 ]; then
        echo "$found"
        return 0
    fi
    if [ "$count" -gt 1 ]; then
        log "multiple USB block partitions found and none identified as $DATA_LABEL/exFAT; refusing to guess"
        dump_usb_state "multiple USB block partitions"
    fi
    return 1
}

external_data_part() {
    root_disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    labeled_found=""
    labeled_count=0
    exfat_found=""
    exfat_count=0
    blkid_usb_found=""
    blkid_usb_count=0

    for part in $(blkid_parts); do
        [ -b "$part" ] || continue
        disk="$(partition_disk "$part")"
        if [ -n "$root_disk" ] && [ "$disk" = "$root_disk" ]; then
            continue
        fi

        type="$(blkid_field TYPE "$part")"
        label="$(blkid_field LABEL "$part")"

        if [ "$label" = "$DATA_LABEL" ]; then
            if [ -n "$type" ] && [ "$type" != "exfat" ]; then
                log "ignoring non-root $DATA_LABEL partition $part: expected exfat, got $type"
                continue
            fi
            labeled_count=$((labeled_count + 1))
            [ -n "$labeled_found" ] || labeled_found="$part"
            continue
        fi

        if [ "$type" = "exfat" ]; then
            exfat_count=$((exfat_count + 1))
            [ -n "$exfat_found" ] || exfat_found="$part"
        elif [ -z "$type" ] && [ -n "$(blkid_field UUID "$part")$label" ]; then
            # Some BusyBox blkid builds report LABEL/UUID for exFAT but omit
            # TYPE. If exactly one USB partition has blkid metadata, try it;
            # mount -t exfat will still fail safely if it is not exFAT.
            blkid_usb_count=$((blkid_usb_count + 1))
            [ -n "$blkid_usb_found" ] || blkid_usb_found="$part"
        fi
    done

    if [ -n "$labeled_found" ]; then
        if [ "$labeled_count" -gt 1 ]; then
            log "warning: multiple non-root $DATA_LABEL partitions found; using $labeled_found"
        fi
        echo "$labeled_found"
        return 0
    fi

    if [ "$exfat_count" -eq 1 ]; then
        log "no USB $DATA_LABEL partition found; using only non-root exFAT partition $exfat_found"
        echo "$exfat_found"
        return 0
    fi
    if [ "$exfat_count" -gt 1 ]; then
        log "multiple non-root exFAT partitions found and none labelled $DATA_LABEL; refusing to guess"
        dump_usb_state "multiple non-root exFAT partitions"
        return 1
    fi

    if [ "$blkid_usb_count" -eq 1 ]; then
        log "blkid omitted filesystem TYPE; trying only USB partition with blkid metadata $blkid_usb_found"
        echo "$blkid_usb_found"
        return 0
    fi
    if [ "$blkid_usb_count" -gt 1 ]; then
        log "multiple USB partitions have blkid metadata but no exFAT TYPE; refusing to guess"
        dump_usb_state "multiple untyped blkid USB partitions"
        return 1
    fi

    candidate="$(single_usb_block_part || true)"
    if [ -n "$candidate" ]; then
        log "blkid did not identify USB exFAT; trying only USB block partition $candidate"
        echo "$candidate"
        return 0
    fi
    return 1
}

wait_for_external_data_part() {
    i=0
    while [ "$i" -le "$USB_WAIT_SECS" ]; do
        part="$(external_data_part)"
        if [ -n "$part" ]; then
            echo "$part"
            return 0
        fi
        [ "$i" -eq "$USB_WAIT_SECS" ] && break
        [ "$i" -eq 0 ] && log "waiting up to ${USB_WAIT_SECS}s for USB data partition"
        sleep 1
        i=$((i + 1))
    done
    if [ "$BOOT_DIAGNOSTICS" = "1" ] || [ "$BOOT_DIAGNOSTICS" = "true" ]; then
        dump_usb_state "no USB data partition candidate after ${USB_WAIT_SECS}s"
    fi
    return 1
}

mount_data_part() {
    part="$1"
    source="$2"

    [ -n "$part" ] && [ -b "$part" ] || return 1
    mkdir -p "$DATA_MNT"

    if mounted_at_data; then
        log "$DATA_MNT is already mounted; leaving existing mount in place"
        return 0
    fi

    log "mounting $source data partition $part at $DATA_MNT"
    MOUNT_ERR="/run/S15data.mount.err"
    : >"$MOUNT_ERR" 2>/dev/null || true
    mount -t exfat -o "$MOUNT_OPTS" "$part" "$DATA_MNT" 2>"$MOUNT_ERR" &
    MOUNT_PID=$!
    (
        sleep "$MOUNT_TIMEOUT"
        kill "$MOUNT_PID" 2>/dev/null || true
        log "exfat mount timeout after ${MOUNT_TIMEOUT}s for $part"
    ) &
    TIMER_PID=$!
    wait "$MOUNT_PID" 2>/dev/null || true
    kill "$TIMER_PID" 2>/dev/null || true

    if mounted_at_data; then
        label="$(blkid_field LABEL "$part")"
        if [ -n "$label" ]; then
            log "using $source data partition $part label $label"
        else
            log "using $source data partition $part without label"
        fi
        return 0
    fi

    if [ -s "$MOUNT_ERR" ]; then
        while IFS= read -r line; do
            log "mount error for $part: $line"
        done <"$MOUNT_ERR"
    else
        log "mount error for $part: no stderr from mount"
    fi
    if [ "$BOOT_DIAGNOSTICS" = "1" ] || [ "$BOOT_DIAGNOSTICS" = "true" ]; then
        dump_usb_state "mount failed for $part"
    fi
    log "could not mount $source data partition $part; using rootfs-backed $DATA_MNT"
    return 1
}

case "$1" in
    start)
        log "start"
        mkdir -p "$DATA_MNT"

        USB_PART="$(wait_for_external_data_part || true)"
        if [ -n "$USB_PART" ]; then
            mount_data_part "$USB_PART" "USB" || true
        fi

        if ! mounted_at_data; then
            SD_PART="$(sd_data_part_from_rootfs_disk 2>/dev/null || true)"
            if [ -n "$SD_PART" ] && [ -b "$SD_PART" ]; then
                if [ -n "$USB_PART" ]; then
                    log "USB data partition $USB_PART was not mounted; falling back to SD $SD_PART"
                else
                    log "no USB data partition found; falling back to SD $SD_PART"
                fi
                mount_data_part "$SD_PART" "SD fallback" || true
            else
                if [ -n "$USB_PART" ]; then
                    log "USB data partition $USB_PART was not mounted and SD fallback partition is missing; attempting first-boot provisioning"
                else
                    log "no USB data partition found and SD fallback partition is missing; attempting first-boot provisioning"
                fi
                if provision_sd_data_part; then
                    SD_PART="$(sd_data_part_from_rootfs_disk 2>/dev/null || true)"
                    mount_data_part "$SD_PART" "SD fallback" || true
                fi
                if ! mounted_at_data; then
                    log "SD fallback provisioning did not mount; using rootfs-backed $DATA_MNT"
                fi
            fi
        fi

        mkdir -p "$DATA_MNT/captures"
        # Export any existing boot crumb log to the user-visible data partition.
        /usr/sbin/equip1-export-logs once >/dev/null 2>&1 || true
        sync
        ;;
    stop)
        umount "$DATA_MNT" 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
