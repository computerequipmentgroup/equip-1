# Equip-1 Buildroot defconfig for Raspberry Pi 5 + PiSugar 3 Plus
# 64-bit AArch64 image targeting Firehat + PiSugar battery power manager.

# Architecture: AArch64 Cortex-A76 (BCM2712)
BR2_aarch64=y
BR2_cortex_a76=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
# C++ support — required by dvgrab (vendored via br2-external)
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y

# Kernel — Raspberry Pi 5 downstream 6.6 kernel, matching Buildroot's Pi 5 baseline.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment linux-pi5.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Raspberry Pi boot firmware/config.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="config_5_pisugar.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="cmdline_5.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# Filesystem — ~1GB system partition; recordings live on a separate exFAT
# partition created from the rest of the SD on first boot (see S15data).
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
# Keep rootfs.tar available for debugging/staging parity with the ROCK 2F build.
BR2_TARGET_ROOTFS_TAR=y

# Init system — BusyBox init for fast boot
BR2_INIT_BUSYBOX=y

# System
BR2_TARGET_GENERIC_HOSTNAME="equip-1"
BR2_TARGET_GENERIC_ISSUE="Equip-1 DV Recorder"
BR2_TARGET_GENERIC_ROOT_PASSWD="equip1"
BR2_TARGET_GENERIC_PASSWD_SHA512=y
# Wi-Fi/AP/DHCP is handled by overlay/etc/init.d/S50network.

# Python 3 (for application services)
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PIP=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_ZLIB=y

# I2C tools (OLED + PiSugar)
BR2_PACKAGE_I2C_TOOLS=y

# Recordings partition tooling: sgdisk (create), mkfs.exfat (format), partprobe
BR2_PACKAGE_GPTFDISK=y
# Recordings partition tooling: parted/partprobe creates the first-boot data partition,
# mkfs.exfat formats it as EQUIP1.
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_PARTED=y

# WiFi + production access point
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_CLI=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_DNSMASQ_DHCP=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_WIRELESS=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_CRDA=y

# FireWire (IEEE 1394) support
BR2_PACKAGE_LIBRAW1394=y

# dvgrab for DV capture
BR2_PACKAGE_DVGRAB=y

# ffmpeg extracts JPEG thumbnails, generates browser preview streams, and drives
# the HDMI framebuffer preview. swscale is required for scale/pad filters;
# output devices are required for ffmpeg's fbdev output.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_FFMPEG_OUTDEVS=y

# GPIO/peripheral access
BR2_PACKAGE_LIBGPIOD=y

# Disable unnecessary packages for minimal image
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# Overlay
BR2_ROOTFS_OVERLAY="overlay"

# SD card image generation
BR2_ROOTFS_POST_BUILD_SCRIPT="post-build-pi5.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c genimage-pi5.cfg"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y
