# Equip-1 Raspberry Pi 5 kernel config fragment
# Applied on top of bcm2712_defconfig and Buildroot's 4K page-size fragment.

# IEEE 1394 / FireWire for the Firehat controller on Pi 5 PCIe.
CONFIG_FIREWIRE=y
CONFIG_FIREWIRE_OHCI=y
CONFIG_FIREWIRE_SBP2=y
CONFIG_FIREWIRE_NET=n

# I2C userspace access for OLED and PiSugar 3 Plus.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2835=y

# GPIO userspace access for buttons/buzzer.
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=y

# SPI userspace access for RGB LEDs on SPI0 MOSI.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_BCM2835=y
CONFIG_SPI_SPIDEV=y

# exFAT for the recordings partition (laptop-readable on macOS/Windows).
CONFIG_EXFAT_FS=y

# Partition table parsers for USB sticks formatted by common desktop OSes.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MAC_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# USB-A host storage for recording to external flash drives / SSDs.
CONFIG_USB=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y

# Keep the DRM/fbdev path needed by the HDMI framebuffer preview.
CONFIG_FB=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Trim unused interactive input classes.
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_SOUND=n
CONFIG_INFINIBAND=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FTRACE=n
