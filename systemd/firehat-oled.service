[Unit]
Description=Firehat OLED/button frontend
After=firehatd.service
Wants=firehatd.service

[Service]
Type=simple
User=firehat
Group=firehat
WorkingDirectory=/opt/firehat
Environment=EQUIP_1_BOARD_TYPE=rock2f
Environment=FIREHAT_API_BASE=http://127.0.0.1:8000/api
ExecStart=/opt/firehat/.venv/bin/python -m uis.oled
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
