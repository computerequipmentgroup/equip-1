#!/bin/sh
# Runtime switch for the Firehat /data capture volume.
#
# Switches are mediated by firehatd. The daemon may invoke this from an idle
# auto-detect loop, but never while recording, so /data can be unmounted safely.

set -u

DATA_MNT="${FIREHAT_DATA_MNT:-/data}"
DATA_LABEL="${FIREHAT_DATA_LABEL:-EQUIP1}"
MOUNT_OPTS="${FIREHAT_DATA_MOUNT_OPTS:-noatime}"
MOUNT_TIMEOUT="${FIREHAT_DATA_MOUNT_TIMEOUT:-15}"
USB_WAIT_SECS="${FIREHAT_USB_DATA_WAIT_SECS:-5}"
LOGFILE="/var/log/storage-switch.log"
BOOT_LOG="/var/log/boot-crumb.log"
USB_STORAGE_ACTIVE="/run/firehat-usb-storage.active"

log() {
    mkdir -p /var/log /run 2>/dev/null || true
    line="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) storage-switch: $*"
    echo "$line" >>"$LOGFILE" 2>/dev/null || true
    echo "$line" >>"$BOOT_LOG" 2>/dev/null || true
    if mounted_at_data; then
        echo "$line" >>"$DATA_MNT/storage-switch.log" 2>/dev/null || true
    fi
    echo "$*" >&2
}

mounted_at_data() {
    awk -v m="$DATA_MNT" '$2 == m { found=1 } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

dump_usb_state() {
    reason="$1"
    log "USB diagnostics begin: $reason"
    {
        echo "--- /proc/partitions ---"
        cat /proc/partitions 2>/dev/null || true
        echo "--- blkid ---"
        blkid 2>&1 || true
        echo "--- /sys/block/sd* ---"
        for disk_path in /sys/block/sd*; do
            [ -e "$disk_path" ] || continue
            disk="$(basename "$disk_path")"
            echo "$disk: removable=$(cat "$disk_path/removable" 2>/dev/null || echo '?') size=$(cat "$disk_path/size" 2>/dev/null || echo '?')"
            for part_path in "$disk_path"/"$disk"[0-9]*; do
                [ -e "$part_path" ] || continue
                part="$(basename "$part_path")"
                echo "  $part size=$(cat "$part_path/size" 2>/dev/null || echo '?') dev=$(cat "$part_path/dev" 2>/dev/null || echo '?')"
            done
        done
        echo "--- /dev/sd* ---"
        ls -l /dev/sd* 2>&1 || true
        echo "--- dmesg usb tail ---"
        dmesg 2>/dev/null | grep -iE 'usb|uas|scsi|sd[a-z]|exfat' | tail -60 || true
    } | while IFS= read -r line; do
        log "diag: $line"
    done
    log "USB diagnostics end: $reason"
}

mounted_data_part() {
    awk -v m="$DATA_MNT" '$2 == m { print $1; exit }' /proc/mounts 2>/dev/null
}

partition_disk() {
    part="$1"
    case "$part" in
        *mmcblk*p[0-9]*|*nvme*n[0-9]*p[0-9]*) echo "${part%p[0-9]*}" ;;
        /dev/*[0-9])                              echo "${part%[0-9]*}" ;;
        *)                                        echo "$part" ;;
    esac
}

root_disk_from_rootfs() {
    rootdev="$(blkid 2>/dev/null | grep 'LABEL="rootfs"' | head -1 | cut -d: -f1)"
    [ -n "$rootdev" ] || return 1
    partition_disk "$rootdev"
}

sd_data_part_from_rootfs_disk() {
    disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    [ -n "$disk" ] || return 1
    case "$disk" in
        *mmcblk*|*nvme*) echo "${disk}p2" ;;
        /dev/?*)         echo "${disk}2" ;;
        *)               return 1 ;;
    esac
}

blkid_field() {
    field="$1"
    part="$2"
    value="$(blkid -o value -s "$field" "$part" 2>/dev/null || true)"
    case "$value" in
        *"$field="*|*LABEL=*|*UUID=*|*TYPE=*|/dev/*:*) ;;
        *) [ -n "$value" ] && { echo "$value"; return 0; } ;;
    esac
    blkid "$part" 2>/dev/null | sed -n "s/.*$field=\"\([^\"]*\)\".*/\1/p" | head -1
}

blkid_parts() {
    blkid 2>/dev/null | cut -d: -f1
}

usb_block_parts() {
    root_disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    for disk_path in /sys/block/sd*; do
        [ -e "$disk_path" ] || continue
        disk="/dev/$(basename "$disk_path")"
        if [ -n "$root_disk" ] && [ "$disk" = "$root_disk" ]; then
            continue
        fi

        found_part=0
        for part_path in "$disk_path"/$(basename "$disk_path")[0-9]*; do
            [ -e "$part_path" ] || continue
            part="/dev/$(basename "$part_path")"
            [ -b "$part" ] || continue
            echo "$part"
            found_part=1
        done
        if [ "$found_part" -eq 0 ] && [ -b "$disk" ]; then
            echo "$disk"
        fi
    done
}

single_usb_block_part() {
    found=""
    count=0
    for part in $(usb_block_parts); do
        count=$((count + 1))
        [ -n "$found" ] || found="$part"
    done
    if [ "$count" -eq 1 ]; then
        echo "$found"
        return 0
    fi
    if [ "$count" -gt 1 ]; then
        log "multiple USB block partitions found and none identified as $DATA_LABEL/exFAT; refusing to guess"
        dump_usb_state "multiple USB block partitions"
    fi
    return 1
}

external_data_part() {
    root_disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    labeled_found=""
    labeled_count=0
    exfat_found=""
    exfat_count=0
    blkid_usb_found=""
    blkid_usb_count=0

    for part in $(blkid_parts); do
        [ -b "$part" ] || continue
        disk="$(partition_disk "$part")"
        if [ -n "$root_disk" ] && [ "$disk" = "$root_disk" ]; then
            continue
        fi

        type="$(blkid_field TYPE "$part")"
        label="$(blkid_field LABEL "$part")"

        if [ "$label" = "$DATA_LABEL" ]; then
            if [ -n "$type" ] && [ "$type" != "exfat" ]; then
                log "ignoring non-root $DATA_LABEL partition $part: expected exfat, got $type"
                continue
            fi
            labeled_count=$((labeled_count + 1))
            [ -n "$labeled_found" ] || labeled_found="$part"
            continue
        fi

        if [ "$type" = "exfat" ]; then
            exfat_count=$((exfat_count + 1))
            [ -n "$exfat_found" ] || exfat_found="$part"
        elif [ -z "$type" ] && [ -n "$(blkid_field UUID "$part")$label" ]; then
            # Some BusyBox blkid builds report LABEL/UUID for exFAT but omit
            # TYPE. If exactly one USB partition has blkid metadata, try it;
            # mount -t exfat will still fail safely if it is not exFAT.
            blkid_usb_count=$((blkid_usb_count + 1))
            [ -n "$blkid_usb_found" ] || blkid_usb_found="$part"
        fi
    done

    if [ -n "$labeled_found" ]; then
        if [ "$labeled_count" -gt 1 ]; then
            log "warning: multiple non-root $DATA_LABEL partitions found; using $labeled_found"
        fi
        echo "$labeled_found"
        return 0
    fi

    if [ "$exfat_count" -eq 1 ]; then
        log "no USB $DATA_LABEL partition found; using only non-root exFAT partition $exfat_found"
        echo "$exfat_found"
        return 0
    fi
    if [ "$exfat_count" -gt 1 ]; then
        log "multiple non-root exFAT partitions found and none labelled $DATA_LABEL; refusing to guess"
        dump_usb_state "multiple non-root exFAT partitions"
        return 1
    fi

    if [ "$blkid_usb_count" -eq 1 ]; then
        log "blkid omitted filesystem TYPE; trying only USB partition with blkid metadata $blkid_usb_found"
        echo "$blkid_usb_found"
        return 0
    fi
    if [ "$blkid_usb_count" -gt 1 ]; then
        log "multiple USB partitions have blkid metadata but no exFAT TYPE; refusing to guess"
        dump_usb_state "multiple untyped blkid USB partitions"
        return 1
    fi

    candidate="$(single_usb_block_part || true)"
    if [ -n "$candidate" ]; then
        log "blkid did not identify USB exFAT; trying only USB block partition $candidate"
        echo "$candidate"
        return 0
    fi
    return 1
}

wait_for_external_data_part() {
    i=0
    while [ "$i" -le "$USB_WAIT_SECS" ]; do
        part="$(external_data_part)"
        if [ -n "$part" ]; then
            echo "$part"
            return 0
        fi
        [ "$i" -eq "$USB_WAIT_SECS" ] && break
        [ "$i" -eq 0 ] && log "waiting up to ${USB_WAIT_SECS}s for USB data partition"
        sleep 1
        i=$((i + 1))
    done
    return 1
}

part_source() {
    part="$1"
    disk="$(partition_disk "$part")"
    root_disk="$(root_disk_from_rootfs 2>/dev/null || true)"
    if [ -n "$root_disk" ] && [ "$disk" = "$root_disk" ]; then
        echo "SD/rootfs-disk"
    else
        echo "USB/external"
    fi
}

mount_data_part() {
    part="$1"
    source="$2"

    [ -n "$part" ] && [ -b "$part" ] || return 1
    mkdir -p "$DATA_MNT" 2>/dev/null || true

    log "mounting $source data partition $part at $DATA_MNT"
    MOUNT_ERR="/run/firehat-storage-switch.mount.err"
    : >"$MOUNT_ERR" 2>/dev/null || true
    mount -t exfat -o "$MOUNT_OPTS" "$part" "$DATA_MNT" 2>"$MOUNT_ERR" &
    MOUNT_PID=$!
    (
        sleep "$MOUNT_TIMEOUT"
        kill "$MOUNT_PID" 2>/dev/null || true
        log "exfat mount timeout after ${MOUNT_TIMEOUT}s for $part"
    ) &
    TIMER_PID=$!
    wait "$MOUNT_PID" 2>/dev/null || true
    kill "$TIMER_PID" 2>/dev/null || true

    if mounted_at_data; then
        mkdir -p "$DATA_MNT/captures" 2>/dev/null || true
        cp "$BOOT_LOG" "$DATA_MNT/boot-crumb.log" 2>/dev/null || true
        label="$(blkid_field LABEL "$part")"
        if [ -n "$label" ]; then
            log "using $source data partition $part label $label"
        else
            log "using $source data partition $part without label"
        fi
        sync
        return 0
    fi

    if [ -s "$MOUNT_ERR" ]; then
        while IFS= read -r line; do
            log "mount error for $part: $line"
        done <"$MOUNT_ERR"
    else
        log "mount error for $part: no stderr from mount"
    fi
    dump_usb_state "mount failed for $part"
    log "could not mount $source data partition $part"
    return 1
}

restore_previous_or_sd() {
    previous="$1"
    if [ -n "$previous" ] && [ -b "$previous" ]; then
        mount_data_part "$previous" "previous $(part_source "$previous")" && return 0
    fi
    sd_part="$(sd_data_part_from_rootfs_disk 2>/dev/null || true)"
    if [ -n "$sd_part" ] && [ -b "$sd_part" ]; then
        mount_data_part "$sd_part" "SD fallback" && return 0
    fi
    mkdir -p "$DATA_MNT/captures" 2>/dev/null || true
    return 1
}

switch_to_part() {
    target="$1"
    source="$2"

    [ -n "$target" ] && [ -b "$target" ] || { log "target data partition not found"; return 1; }

    current="$(mounted_data_part || true)"
    if [ "$current" = "$target" ]; then
        log "$DATA_MNT already mounted from $source data partition $target"
        mkdir -p "$DATA_MNT/captures" 2>/dev/null || true
        return 0
    fi

    if pidof dvgrab >/dev/null 2>&1; then
        log "refusing to switch storage while dvgrab is running"
        return 1
    fi
    if [ -s "$USB_STORAGE_ACTIVE" ]; then
        log "refusing to switch storage while USB disk transfer mode is active"
        return 1
    fi

    log "switching $DATA_MNT from ${current:-rootfs directory} to $source data partition $target"
    sync
    if mounted_at_data; then
        if ! umount "$DATA_MNT"; then
            if [ -n "$current" ] && [ ! -b "$current" ]; then
                log "could not normally unmount stale $DATA_MNT source $current; trying lazy unmount"
                if ! umount -l "$DATA_MNT"; then
                    log "could not lazily unmount $DATA_MNT; leaving current storage active"
                    return 1
                fi
            else
                log "could not unmount $DATA_MNT; leaving current storage active"
                return 1
            fi
        fi
    fi

    if mount_data_part "$target" "$source"; then
        log "storage switch complete: $DATA_MNT now uses $source data partition $target"
        return 0
    fi

    log "storage switch failed; attempting to restore previous/fallback storage"
    restore_previous_or_sd "$current" || true
    return 1
}

status_mode() {
    current="$(mounted_data_part || true)"
    if [ -n "$current" ]; then
        echo "part=$current"
        echo "source=$(part_source "$current")"
        echo "mount=$DATA_MNT"
        exit 0
    fi
    echo "part="
    echo "source=rootfs-directory"
    echo "mount=$DATA_MNT"
    exit 1
}

case "${1:-}" in
    usb)
        target="$(wait_for_external_data_part || true)"
        [ -n "$target" ] || { log "no unambiguous USB exFAT data partition found"; dump_usb_state "no USB data partition candidate"; exit 1; }
        switch_to_part "$target" "USB"
        ;;
    sd)
        target="$(sd_data_part_from_rootfs_disk 2>/dev/null || true)"
        [ -n "$target" ] || { log "no SD fallback data partition found"; exit 1; }
        switch_to_part "$target" "SD fallback"
        ;;
    status)
        status_mode
        ;;
    *)
        echo "Usage: $0 {usb|sd|status}"
        exit 2
        ;;
esac
