#!/bin/sh
# Mount the recordings data partition at /data.
#
# The recordings partition (exFAT, label EQUIP1) is created by flash.sh on the
# host when the card is written. Here we just find it (partition 2 of the boot
# disk) and mount it at /data so the app can write captures to /data/captures.
# If it isn't present, /data falls back to the rootfs so recording still works.

DATA_MNT="/data"

case "$1" in
    start)
        echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) S15data start" >> /var/log/boot-crumb.log 2>/dev/null || true
        # Boot disk = the disk holding the rootfs (found via its filesystem label).
        DISK=$(blkid 2>/dev/null | grep 'LABEL="rootfs"' | head -1 | cut -d: -f1 | sed 's/p[0-9]*$//')
        PART=""
        case "$DISK" in
            *mmcblk*|*nvme*) PART="${DISK}p2" ;;
            /dev/?*)         PART="${DISK}2" ;;
        esac

        mkdir -p "$DATA_MNT"
        if [ -n "$PART" ] && [ -b "$PART" ]; then
            if ! grep -q " $DATA_MNT exfat" /proc/mounts 2>/dev/null; then
                # Mount with a background timeout. A corrupted exFAT from an
                # unclean shutdown can cause mount to hang indefinitely.
                mount -t exfat "$PART" "$DATA_MNT" 2>/dev/null &
                MOUNT_PID=$!
                (
                    sleep 15
                    kill "$MOUNT_PID" 2>/dev/null || true
                    echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) exfat mount timeout after 15s" >> /var/log/boot-crumb.log 2>/dev/null || true
                ) &
                TIMER_PID=$!
                wait "$MOUNT_PID" 2>/dev/null || true
                kill "$TIMER_PID" 2>/dev/null || true
            fi
        fi
        mkdir -p "$DATA_MNT/captures"
        # Sync any existing boot crumb log to the data partition.
        cp /var/log/boot-crumb.log "$DATA_MNT/boot-crumb.log" 2>/dev/null || true
        sync
        ;;
    stop)
        umount "$DATA_MNT" 2>/dev/null
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
