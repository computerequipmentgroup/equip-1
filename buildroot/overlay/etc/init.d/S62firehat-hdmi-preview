#!/bin/sh
# Firehat HDMI framebuffer preview for BusyBox init.

PIDFILE=/var/run/firehat-hdmi-preview.pid
LOGFILE=/var/log/firehat-hdmi-preview.log
APPDIR=/opt/firehat

if [ -r /etc/firehat/settings-env.sh ]; then
    . /etc/firehat/settings-env.sh
    firehat_ini_default FIREHAT_HDMI_PREVIEW_ENABLED hdmi enabled 1
    firehat_ini_default FIREHAT_HDMI_STREAM_URL hdmi stream_url 'http://127.0.0.1:8000/api/stream.mkv?takeover=1'
    firehat_ini_default FIREHAT_HDMI_FBDEV hdmi fbdev /dev/fb0
    firehat_ini_default FIREHAT_HDMI_POLL_SECONDS hdmi poll_seconds 1
    firehat_ini_default FIREHAT_HDMI_ASSUME_CONNECTED_WITHOUT_DRM hdmi assume_connected_without_drm 0
    firehat_ini_default FIREHAT_HDMI_PIX_FMT hdmi pix_fmt ""
    firehat_ini_default FIREHAT_HDMI_FFMPEG_LOGLEVEL hdmi ffmpeg_loglevel info
    firehat_ini_default FIREHAT_HDMI_FFMPEG_PROGRESS hdmi ffmpeg_progress 0
    firehat_ini_default FIREHAT_HDMI_FFMPEG_STATS_PERIOD hdmi ffmpeg_stats_period 5
    firehat_ini_default FIREHAT_HDMI_CLEAR_ON_CONNECT hdmi clear_on_connect 1
fi

export FIREHAT_HDMI_PREVIEW_ENABLED="${FIREHAT_HDMI_PREVIEW_ENABLED:-1}"
export FIREHAT_HDMI_STREAM_URL="${FIREHAT_HDMI_STREAM_URL:-http://127.0.0.1:8000/api/stream.mkv?takeover=1}"
export FIREHAT_HDMI_FBDEV="${FIREHAT_HDMI_FBDEV:-/dev/fb0}"
export FIREHAT_HDMI_POLL_SECONDS="${FIREHAT_HDMI_POLL_SECONDS:-1}"
export FIREHAT_HDMI_ASSUME_CONNECTED_WITHOUT_DRM="${FIREHAT_HDMI_ASSUME_CONNECTED_WITHOUT_DRM:-0}"
[ -n "${FIREHAT_HDMI_PIX_FMT:-}" ] && export FIREHAT_HDMI_PIX_FMT
export FIREHAT_HDMI_FFMPEG_LOGLEVEL="${FIREHAT_HDMI_FFMPEG_LOGLEVEL:-info}"
export FIREHAT_HDMI_FFMPEG_PROGRESS="${FIREHAT_HDMI_FFMPEG_PROGRESS:-0}"
export FIREHAT_HDMI_FFMPEG_STATS_PERIOD="${FIREHAT_HDMI_FFMPEG_STATS_PERIOD:-5}"
export FIREHAT_HDMI_CLEAR_ON_CONNECT="${FIREHAT_HDMI_CLEAR_ON_CONNECT:-1}"
export FIREHAT_HDMI_DATA_LOG="${FIREHAT_HDMI_DATA_LOG:-/data/hdmi-preview.log}"

case "$1" in
    start)
        echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) S62firehat-hdmi-preview start" >> /var/log/boot-crumb.log 2>/dev/null || true
        if [ "$FIREHAT_HDMI_PREVIEW_ENABLED" = "0" ] || [ "$FIREHAT_HDMI_PREVIEW_ENABLED" = "false" ]; then
            echo "Firehat HDMI preview disabled"
            exit 0
        fi
        echo "Starting Firehat HDMI framebuffer preview watcher..."
        mkdir -p /var/run /var/log
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "Firehat HDMI framebuffer preview watcher already running"
            exit 0
        fi
        "$APPDIR/scripts/firehat-hdmi-preview-fb.sh" >>"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        ;;
    stop)
        echo "Stopping Firehat HDMI framebuffer preview watcher..."
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
