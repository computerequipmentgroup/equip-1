#!/bin/sh
# Firehat OLED/buttons frontend for BusyBox init.

PIDFILE=/var/run/firehat-oled.pid
LOGFILE=/var/log/firehat-oled.log
APPDIR=/opt/firehat

export PYTHONPATH="$APPDIR/lib:$APPDIR"
if [ -r /etc/firehat/settings-env.sh ]; then
    . /etc/firehat/settings-env.sh
    firehat_ini_default FIREHAT_API_BASE ui api_base http://127.0.0.1:8000/api
    firehat_ini_default FIREHAT_API_TIMEOUT ui api_timeout 5.0
    firehat_ini_default FIREHAT_STATE_FETCH_INTERVAL ui state_fetch_interval 1.0
    firehat_ini_default FIREHAT_BOOT_DURATION_SECONDS ui boot_duration_seconds 3.0
    firehat_ini_default FIREHAT_BOOT_HOLD_SECONDS ui boot_hold_seconds 1.1
    firehat_ini_default FIREHAT_OLED_FRAME_INTERVAL ui oled_frame_interval 0.033333
fi

export EQUIP_1_BOARD_TYPE="${EQUIP_1_BOARD_TYPE:-rock2f}"
export FIREHAT_API_BASE="${FIREHAT_API_BASE:-http://127.0.0.1:8000/api}"
# /api/state can take a few seconds when DV deck probing is active.
export FIREHAT_API_TIMEOUT="${FIREHAT_API_TIMEOUT:-5.0}"
export FIREHAT_STATE_FETCH_INTERVAL="${FIREHAT_STATE_FETCH_INTERVAL:-1.0}"
export FIREHAT_FONT_DIR="${FIREHAT_FONT_DIR:-$APPDIR/fonts}"
export FIREHAT_BOOT_DURATION_SECONDS="${FIREHAT_BOOT_DURATION_SECONDS:-3.0}"
export FIREHAT_BOOT_HOLD_SECONDS="${FIREHAT_BOOT_HOLD_SECONDS:-1.1}"
export FIREHAT_OLED_FRAME_INTERVAL="${FIREHAT_OLED_FRAME_INTERVAL:-0.033333}"
export FIREHAT_OLED_SETTLE_DELAY="${FIREHAT_OLED_SETTLE_DELAY:-0}"
export FIREHAT_OLED_INIT_ATTEMPTS="${FIREHAT_OLED_INIT_ATTEMPTS:-120}"
export FIREHAT_OLED_INIT_DELAY="${FIREHAT_OLED_INIT_DELAY:-1}"
# Three WS2812/SK6812-style RGB LEDs on Rock 2F header pin 19 (SPI0_MOSI).
export FIREHAT_RGB_LED_ENABLED="${FIREHAT_RGB_LED_ENABLED:-1}"
export FIREHAT_RGB_LED_SPI_DEVICE="${FIREHAT_RGB_LED_SPI_DEVICE:-/dev/spidev0.0}"
export FIREHAT_RGB_LED_COUNT="${FIREHAT_RGB_LED_COUNT:-3}"
export FIREHAT_RGB_LED_COLOR="${FIREHAT_RGB_LED_COLOR:-255,135,35}"
export FIREHAT_RGB_LED_BRIGHTNESS="${FIREHAT_RGB_LED_BRIGHTNESS:-0.25}"
# SK6812-EC20 is GRB order, 800 kHz NRZ. We drive it through SPI0_MOSI with
# conservative 3.2 MHz / 4-bit symbols: 0=1000, 1=1110.
export FIREHAT_RGB_LED_ORDER="${FIREHAT_RGB_LED_ORDER:-GRB}"
export FIREHAT_RGB_LED_SPI_HZ="${FIREHAT_RGB_LED_SPI_HZ:-3200000}"
export FIREHAT_RGB_LED_SYMBOL_BITS="${FIREHAT_RGB_LED_SYMBOL_BITS:-4}"
export FIREHAT_RGB_LED_ZERO_SYMBOL="${FIREHAT_RGB_LED_ZERO_SYMBOL:-0b1000}"
export FIREHAT_RGB_LED_ONE_SYMBOL="${FIREHAT_RGB_LED_ONE_SYMBOL:-0b1110}"
export FIREHAT_RGB_LED_TRAIL_FACTOR="${FIREHAT_RGB_LED_TRAIL_FACTOR:-0.20}"
export FIREHAT_RGB_LED_STEP_SECONDS="${FIREHAT_RGB_LED_STEP_SECONDS:-0.28}"

case "$1" in
    start)
        echo "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) S61firehat-oled start" >> /var/log/boot-crumb.log 2>/dev/null || true
        echo "Starting firehat OLED UI..."
        mkdir -p /var/run /var/log
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "firehat OLED UI already running"
            exit 0
        fi
        cd "$APPDIR" || exit 1
        /usr/bin/python3 -m uis.oled >>"$LOGFILE" 2>&1 &
        echo $! > "$PIDFILE"
        ;;
    stop)
        echo "Stopping firehat OLED UI..."
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
