# Equip-1 kernel config fragment
# Applied on top of rockchip_linux_defconfig
# Only overrides and additions needed for Equip-1

# IEEE 1394 / FireWire (for VIA VT6315N on PCIe)
CONFIG_FIREWIRE=y
CONFIG_FIREWIRE_OHCI=y
CONFIG_FIREWIRE_SBP2=y
CONFIG_FIREWIRE_NET=n

# SPI userspace access
CONFIG_SPI_SPIDEV=y

# exFAT for the recordings partition (laptop-readable on macOS/Windows)
CONFIG_EXFAT_FS=y

# Serial console (earlycon via 8250)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# Disable unnecessary subsystems for smaller image
CONFIG_SOUND=n
# Keep DRM enabled: the Rockchip vendor defconfig still links rkx110/rkx120 panel
# support against DRM helpers even on a headless image.
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TOUCHSCREEN=n
# CONFIG_MEDIA_SUPPORT left at defconfig default (rockchip PHY drivers depend on media headers)
# CONFIG_DVB_CORE left at defconfig default
# Disable samsung DCPHY (needs CONFIG_MEDIA_CONTROLLER which we don't need)
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=n
CONFIG_INFINIBAND=n
CONFIG_STAGING=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FTRACE=n
