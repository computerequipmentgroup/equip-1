# Equip-1 kernel config fragment
# Applied on top of rockchip_linux_defconfig
# Only overrides and additions needed for Equip-1

# IEEE 1394 / FireWire (for VIA VT6315N on PCIe)
CONFIG_FIREWIRE=y
CONFIG_FIREWIRE_OHCI=y
CONFIG_FIREWIRE_SBP2=y
CONFIG_FIREWIRE_NET=n

# SPI userspace access. SPI0 MOSI on Rock 2F header pin 19 drives the
# Firehat addressable RGB LED chain during the OLED boot animation.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_SPIDEV=y

# exFAT for the recordings partition (laptop-readable on macOS/Windows)
CONFIG_EXFAT_FS=y

# Partition table parsers for USB sticks formatted by common desktop OSes.
CONFIG_PARTITION_ADVANCED=y
CONFIG_MAC_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# USB-A host storage for recording to external flash drives / SSDs.
CONFIG_USB=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# USB-C transfer mode: expose the EQUIP1 exFAT recordings partition as a
# USB Mass Storage gadget. The runtime script unmounts /data before binding the
# block device so the filesystem is never mounted locally and exported at the
# same time.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MASS_STORAGE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_OTG=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_PHY=y
CONFIG_EXTCON=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# Serial console (earlycon via 8250)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# Disable unnecessary subsystems for smaller image
CONFIG_SOUND=n
# HDMI preview renders directly to /dev/fb0. Keep DRM enabled for the Rockchip
# display pipeline and expose its fbdev compatibility node. The framebuffer
# console (fbcon) must be attached: it performs the initial KMS modeset that
# binds the emulated fbdev onto the CRTC, so raw writes to /dev/fb0 actually
# reach the panel. Without fbcon the emulated framebuffer is never scanned out
# and the display stays on its power-on (white) buffer even though writes to
# /dev/fb0 "succeed". fbcon depends on VT, so enable that too.
CONFIG_FB=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_VGA_CONSOLE=n
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TOUCHSCREEN=n
# CONFIG_MEDIA_SUPPORT left at defconfig default (rockchip PHY drivers depend on media headers)
# CONFIG_DVB_CORE left at defconfig default
# Disable samsung DCPHY (needs CONFIG_MEDIA_CONTROLLER which we don't need)
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=n
CONFIG_INFINIBAND=n
CONFIG_STAGING=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_FTRACE=n
